# SQLite local por defecto. Para PostgreSQL o Supabase sustituye la URL.
# Ejemplos:
#   sqlite:///./geopulse.db
#   postgresql://user:password@host:5432/geopulse
#   postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./geopulse.db
LOG_LEVEL=INFO
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
